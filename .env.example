PORT=8080
DATABASE_URL=
TRACKER_DATABASE_URL=
REDIS_URL=
JWT_SECRET=
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=30
ALLOWED_ORIGINS=*
# GET /progress: repos merged into the landing's progress section, and an
# optional GitHub token (no scopes needed for public repos) to lift the
# 60 requests/hour anonymous limit.
GITHUB_REPOS=IngeniosoHacker/andrho,IngeniosoHacker/andrho-tracker-dashboard,IngeniosoHacker/andrho-api
GITHUB_TOKEN=
# Optional: Claude for the Analyzer (and AndRho's explanations). Without a
# key, rule-based fallbacks are used. Token usage is recorded per call.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
